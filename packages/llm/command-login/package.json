{
  "name": "@deepseek-ai/dsh-command-login",
  "description": "CLI commands for pi-ai subscription login (login, logout, auth status)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/command-login"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-cmdline": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-llm-oauth": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@earendil-works/pi-ai": "^0.82.1"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-cmdline": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-llm-oauth": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@earendil-works/pi-ai": "^0.82.1"
  }
}
